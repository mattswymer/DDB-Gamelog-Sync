{
  "name": "ddb-gamelog-direct-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "Local D&D Beyond game-log bridge for Foundry VTT",
  "type": "module",
  "bin": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build": "pkg . --targets node20-win-x64 --output dist/DDB-Gamelog-Sync.exe"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0"
  },
  "pkg": {
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  }
}
